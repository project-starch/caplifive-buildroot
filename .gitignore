# One output directory per target (build-fpga, build-qemu). Either `build` is a symlink to the
# target directory or the target name is a symlink to the real `build` -- both untracked.
build
build/
build-*
*.bk
.vscode/
.out
# Staging area the board bake step writes .dom images into (board-run skill).
# These are build artifacts regenerated on every bake -- ~9 MB per set. Frozen
# reproducer binaries belong in capstone/tests/fpga-repros/<ID>/, where they are
# committed deliberately, not here.
overlay/test-domains/
