/dts-v1/;

/ {
  #address-cells = <2>;
  #size-cells = <2>;
  compatible = "eth,ariane-bare-dev";
  model = "eth,ariane-bare";
  chosen {
    stdout-path = "/soc/uart@10000000:57600";
    bootargs = "earlycon console=ttyS0,57600";
  };
  cpus {
    #address-cells = <1>;
    #size-cells = <0>;
    timebase-frequency = <12500000>;
    CPU0: cpu@0 {
      clock-frequency = <25000000 >;
      device_type = "cpu";
      reg = <0>;
      status = "okay";
      compatible = "eth, ariane", "riscv";
      riscv,isa = "rv64imafdc";
      mmu-type = "riscv,sv39";
      tlb-split;
      // HLIC - hart local interrupt controller
      CPU0_intc: interrupt-controller {
        #interrupt-cells = <1>;
        interrupt-controller;
        compatible = "riscv,cpu-intc";
      };
    };
  };
  memory@80000000 {
    device_type = "memory";
    /* Usable DRAM must stop BELOW the RTL's shadow-tag region, or Linux hands out tag memory
       as ordinary RAM and dies in early init (observed 2026-08-05: boot stalls just after
       "riscv-intc: 64 local interrupts mapped", reproducibly, on both boots).
       The top comes from core/include/ariane_pkg.sv MEMORY_TOP == CAP_TAG_MEM_BASE:
         7aac52f93  (1021-node)  CAP_TAG_MEM_BASE = 0xBC3C_0000  -> size 0x3C3C0000
         458982093  (65536-node) CAP_TAG_MEM_BASE = 0xBC2D_2D2D  -> size 0x3C2D2000
       0x3C2D2000 is the exact 0x3C2D2D2D rounded DOWN to a 4 KiB page. The tag region that
       remains (0x3C2D2D3 bytes, up to CAP_REVNODE_MEM_BASE = 0xBFF0_0000) still covers
       size/16 = 0x3C2D200, as the hardware requires (tag_addr = CAP_TAG_MEM_BASE + paddr>>4).
       RE-DERIVE THIS FROM THE RTL AFTER ANY RE-FLASH -- the pool size moves both constants,
       and calculate_memory.py prints the pair to paste. */
    reg = <0x0 0x80000000 0x0 0x3c2d2000>;
  };

  /* CMA, so a capability region can exceed the buddy allocator's largest block (MAX_ORDER 10 x
     4 KiB = 4 MiB). Proven on QEMU 2026-09-11: 8 MiB fails to CREATE without an area and succeeds
     with one, and a 130 MiB region maps and round-trips its first and last byte.
     THREE PROPERTIES HERE ARE LOAD-BEARING:
       linux,cma-default  -- modcapstone registers its device with platform_device_register_simple
                             and no DT node, so dev->cma_area is never set and dma_alloc_contiguous
                             falls through to dma_contiguous_default_area. ONLY a node carrying this
                             property sets that. Without it the area exists and nothing can reach it.
       reusable           -- required; kernel/dma/contiguous.c rejects the node without it, and
                             it is what lets movable pages use the area while no region holds it.
       no `no-map`        -- its presence is rejected outright.
     THE AREA SITS INSIDE memory@80000000 AND DOES NOT EXTEND IT. There are only 3373 bytes of slack
     between that node's top and the RTL's CAP_TAG_MEM_BASE (0xBC2D2D2D); growing the memory node is
     what handed Linux tag memory as RAM in Aug 2026 and cost two boots.
       base 0xAC000000, size 0x10000000 (256 MiB), ending at 0xBC000000 -- 4 MiB aligned, which
       CMA_MIN_ALIGNMENT (PAGE_SIZE * pageblock_nr_pages) requires, and 2.8 MiB clear of the top. */
  reserved-memory {
    #address-cells = <2>;
    #size-cells = <2>;
    ranges;
    capstone_cma: linux,cma@ac000000 {
      compatible = "shared-dma-pool";
      reusable;
      linux,cma-default;
      reg = <0x0 0xac000000 0x0 0x10000000>;
    };
  };

  leds {
    compatible = "gpio-leds";
    heartbeat-led {
      gpios = <&xlnx_gpio 1 0>;
      linux,default-trigger = "heartbeat";
      retain-state-suspended;
    };
  };
  L26: soc {
    #address-cells = <2>;
    #size-cells = <2>;
    compatible = "eth,ariane-bare-soc", "simple-bus";
    ranges;
    clint@2000000 {
      compatible = "riscv,clint0";
      interrupts-extended = <&CPU0_intc 3 &CPU0_intc 7>;
      reg = <0x0 0x2000000 0x0 0xc0000>;
      reg-names = "control";
    };
    PLIC0: interrupt-controller@c000000 {
      #address-cells = <0>;
      #interrupt-cells = <1>;
      compatible = "riscv,plic0";
      interrupt-controller;
      interrupts-extended = <&CPU0_intc 11 &CPU0_intc 9>;
      reg = <0x0 0xc000000 0x0 0x4000000>;
      riscv,max-priority = <7>;
      riscv,ndev = <30>;
    };
    // Specifying the interrupt controller in the devicetree is not necessary.
    // Furthermore, the IRQ 65535 will cause a `hwirq 0xffff is too large` during
    // Linux boot (occured with mainline linux 5.14.0).
    // debug-controller@0 {
    //   compatible = "riscv,debug-013";
    //   interrupts-extended = <&CPU0_intc 65535>;
    //   reg = <0x0 0x0 0x0 0x1000>;
    //   reg-names = "control";
    // };
    uart@10000000 {
      compatible = "ns16550a";
      reg = <0x0 0x10000000 0x0 0x1000>;
      clock-frequency = <25000000 >;
      current-speed = <57600>;
      interrupt-parent = <&PLIC0>;
      interrupts = <1>;
      reg-shift = <2>; // regs are spaced on 32 bit boundary
      reg-io-width = <4>; // only 32-bit access are supported
    };
    timer@18000000 {
      compatible = "pulp,apb_timer";
      interrupts = <0x00000004 0x00000005 0x00000006 0x00000007>;
      reg = <0x00000000 0x18000000 0x00000000 0x00001000>;
      interrupt-parent = <&PLIC0>;
      reg-names = "control";
    };
    xps-spi@20000000 {
      compatible = "xlnx,xps-spi-2.00.b", "xlnx,xps-spi-2.00.a";
      #address-cells = <1>;
      #size-cells = <0>;
      interrupt-parent = <&PLIC0>;
      interrupts = < 2 2 >;
      reg = < 0x0 0x20000000 0x0 0x1000 >;
      xlnx,family = "kintex7";
      xlnx,fifo-exist = <0x1>;
      xlnx,num-ss-bits = <0x1>;
      xlnx,num-transfer-bits = <0x8>;
      xlnx,sck-ratio = <0x4>;

      mmc@0 {
        compatible = "mmc-spi-slot";
        reg = <0>;
        spi-max-frequency = <12500000>;
        voltage-ranges = <3300 3300>;
        disable-wp;
      };

      // mmc-slot@0 {
      //   compatible = "fsl,mpc8323rdb-mmc-slot", "mmc-spi-slot";
      //   reg = <0>;  //Chip select 0
      //   spi-max-frequency = <12500000>;
      //   voltage-ranges = <3300 3300>;
      //   //interrupts = < 2 2 >;
      //   //interrupt-parent = <&PLIC0>;
      // };
    };
    eth: lowrisc-eth@30000000 {
      compatible = "lowrisc-eth";
      device_type = "network";
      interrupt-parent = <&PLIC0>;
      interrupts = <3 0>;
      local-mac-address = [00 18 3e 02 e3 7f]; // This needs to change if more than one GenesysII on a VLAN
      reg = <0x0 0x30000000 0x0 0x8000>;
    };
    xlnx_gpio: gpio@40000000 {
      #gpio-cells = <2>;
      compatible = "xlnx,xps-gpio-1.00.a";
      gpio-controller ;
      reg = <0x0 0x40000000 0x0 0x10000 >;
      xlnx,all-inputs = <0x0>;
      xlnx,all-inputs-2 = <0x0>;
      xlnx,dout-default = <0x0>;
      xlnx,dout-default-2 = <0x0>;
      xlnx,gpio-width = <0x8>;
      xlnx,gpio2-width = <0x8>;
      xlnx,interrupt-present = <0x0>;
      xlnx,is-dual = <0x1>;
      xlnx,tri-default = <0xffffffff>;
      xlnx,tri-default-2 = <0xffffffff>;
    };
  };
};
